# ============================================================
# AI TOY BUILDER - ENVIRONMENT CONFIGURATION
# ============================================================

# ─── NODE BACKEND ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://sannikumargupta43_db_user:XXKCe6RwSb15AYOI@cluster0.xpuk23m.mongodb.net/?appName=Cluster0

# JWT Secret (for future auth extension)
JWT_SECRET=dklbcasdbchfasbchdascbkxbghsdagcfuiasgcjkaxbcbjaxcvghiasdviadsv

# Python AI Server URL
AI_SERVER_URL=http://localhost:8000

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ─── PYTHON AI SERVER ────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8000
AI_RELOAD=true

# YOLOv8 Model Settings
YOLO_MODEL_PATH=models/toy_detector.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640

# Use pretrained COCO weights as fallback if custom model not found
YOLO_FALLBACK_WEIGHTS=yolov8n.pt

# ─── GENERATIVE AI (OPTIONAL - STABLE DIFFUSION) ────────────
# Set to true to enable advanced toy image generation
ENABLE_GENERATIVE_AI=false
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
HF_API_TOKEN=your_huggingface_api_token_here

# ─── OPENAI (OPTIONAL - for GPT-based toy naming) ───────────
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_OPENAI=false

# ─── FRONTEND (React Vite) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_NAME=AI Toy Builder
VITE_APP_VERSION=1.0.0

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ─── REDIS (Optional - for queue/caching) ────────────────────
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=false

# ─── DATASET & TRAINING ──────────────────────────────────────
DATASET_PATH=dataset
EPOCHS=50
BATCH_SIZE=16
IMG_SIZE=640
